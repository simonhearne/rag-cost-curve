# Credentials for the benchmark harness. Copy to `.env`, fill in real values,
# and export them:
#
#     cp .env.example .env      # .env is gitignored; .env.example is not
#     set -a; source .env; set +a
#
# NOTE: no code in this repo reads `.env` automatically — python-dotenv is not
# a dependency. The file is a convenience for the shell; the harness only ever
# sees these as environment variables. If a run fails with a missing-credential
# error, check `env | grep -E 'ANTHROPIC|OPENAI|MILVUS'` first.
#
# Never commit real values. This repo is published.

# ---------------------------------------------------------------- Anthropic --
# Agent model, judge model, and messages.count_tokens.
# Read implicitly by anthropic.Anthropic(); no harness code touches it directly.
# Needed by: notebook 06a, scripts/code-retrieval/build_ws6a_corpus.py, the smoke and full runs.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------- OpenAI --
# Embeddings for claude-context (text-embedding-3-small, its shipped default).
# Passed through to the MCP server's environment, not used by Python directly.
OPENAI_API_KEY=

# ------------------------------------------------- Zilliz Cloud / Milvus -----
# The vector store backing claude-context's index.
#
# These are deliberately named MILVUS_*, not ZILLIZ_*: @zilliz/claude-context-mcp
# recognises only MILVUS_ADDRESS and MILVUS_TOKEN (verified against the package's
# dist/ — there is no alias).
#
# MILVUS_ADDRESS is the cluster's public endpoint, e.g.
#   https://in03-xxxxxxxxxxxxxxx.serverless.gcp-us-west1.cloud.zilliz.com
MILVUS_ADDRESS=
MILVUS_TOKEN=
